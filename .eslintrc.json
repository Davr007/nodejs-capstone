{
    "env": {
    "node": true,
        "es2021": true,
        "commonjs": true
},
    "extends": ["eslint:recommended"],
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "module"
},
    "rules": {
    "no-unused-vars": "warn",
        "no-undef": "error",
        "semi": ["error", "always"],
        "quotes": ["error", "single"],
        "indent": ["error", 2],
        "no-console": "off"
}
}
